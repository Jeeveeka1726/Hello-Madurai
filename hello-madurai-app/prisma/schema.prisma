// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model News {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(500)
  title_ta      String?  @db.VarChar(500)
  content       String   @db.LongText  // Unlimited content!
  content_ta    String?  @db.LongText  // Unlimited content!
  excerpt       String   @db.Text
  excerpt_ta    String?  @db.Text
  category      String
  author        String
  featuredImage String?  @db.VarChar(500)
  publishedAt   DateTime @default(now())
  views         Int      @default(0)
  likes         Int      @default(0)
  dislikes      Int      @default(0)
  featured      Boolean  @default(false)
  allowDownload Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  comments      NewsComment[]
  shares        NewsShare[]

  @@map("news")
}

model Event {
  id            String   @id @default(cuid())
  title         String
  title_ta      String?
  description   String   @db.Text
  description_ta String?  @db.Text
  location      String
  location_ta   String?
  featuredImage String?  @db.Text  // Store image data
  startDate     DateTime
  startTime     String?  // Time in HH:mm format (e.g., "14:30")
  endDate       DateTime?
  endTime       String?  // Time in HH:mm format (e.g., "18:00")
  duration      String?  // e.g., "3 Days", "1 Week"
  category      String
  status        String   @default("upcoming") // upcoming, ongoing, completed
  website       String?  // Website URL for booking
  phone         String?  // Phone number for booking
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("events")
}

// Radio Show Folders (e.g., "Hello Madurai", "Music Shows", etc.)
model RadioFolder {
  id          String   @id @default(cuid())
  name        String
  name_ta     String?
  description String?
  description_ta String?
  coverImage  String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationship to radio shows
  radioShows  RadioShow[]

  @@map("radio_folders")
}

// Individual Radio Shows within folders
model RadioShow {
  id          String   @id @default(cuid())
  title       String
  title_ta    String?
  description String
  description_ta String?
  host        String
  duration    String
  audioUrl    String
  featured    Boolean  @default(false)
  plays       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationship to folder
  folderId    String
  folder      RadioFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // New relationships
  comments    RadioComment[]
  shares      RadioShare[]

  @@map("radio_shows")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  name_ta     String?
  description String
  description_ta String?
  category    String
  phone       String?
  email       String?
  website     String?
  address     String
  address_ta  String?
  
  // New business features
  instagramUrl String?
  facebookUrl String?
  bookingUrl  String?
  latitude    Float?   // For Google Maps
  longitude   Float?   // For Google Maps
  
  featured    Boolean  @default(false)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  comments    BusinessComment[]

  @@map("businesses")
}


// Magazine Collections (e.g., "Monthly Issues", "Special Editions", etc.)
model MagazineCollection {
  id          String   @id @default(cuid())
  name        String
  name_ta     String?
  description String?
  description_ta String?
  coverImage  String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationship to magazines
  magazines   Magazine[]

  @@map("magazine_collections")
}

// Individual Magazines within collections
model Magazine {
  id            String   @id @default(cuid())
  title         String
  title_ta      String?
  description   String
  description_ta String?
  pdfUrl        String
  coverImage    String?
  featuredImage String?
  issueNumber   String
  publishedAt   DateTime @default(now())
  downloads     Int      @default(0)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationship to collection
  collectionId  String
  collection    MagazineCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("magazines")
}

// Comments for news articles
model NewsComment {
  id        String   @id @default(cuid())
  content   String
  author    String
  email     String?
  approved  Boolean  @default(false)  // Admin moderation
  isAdminReply Boolean @default(false) // True if reply is from admin
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  
  // Reply functionality
  parentId  String?
  parent    NewsComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   NewsComment[] @relation("CommentReplies")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId])
  @@index([approved])
  @@index([parentId])
  @@map("news_comments")
}

// Share tracking for news articles
model NewsShare {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  platform  String   // facebook, twitter, whatsapp, etc.
  userAgent String?
  createdAt DateTime @default(now())

  @@map("news_shares")
}


// Comments for radio shows
model RadioComment {
  id          String    @id @default(cuid())
  content     String
  author      String
  email       String?
  radioShowId String
  radioShow   RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("radio_comments")
}

// Share tracking for radio shows
model RadioShare {
  id          String    @id @default(cuid())
  radioShowId String
  radioShow   RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade)
  platform    String
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@map("radio_shares")
}

// Business directory comments
model BusinessComment {
  id         String   @id @default(cuid())
  content    String
  author     String
  email      String?
  rating     Int?     // 1-5 star rating
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("business_comments")
}

// Helpline contacts
model Helpline {
  id          String   @id @default(cuid())
  name        String
  name_ta     String?
  phone       String
  category    String   // emergency, medical, police, etc.
  description String?
  description_ta String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("helplines")
}

// Popup ads management
model PopupAd {
  id          String   @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  actionUrl   String?
  actionText  String?
  active      Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("popup_ads")
}

// User subscriptions
model Subscription {
  id          String   @id @default(cuid())
  email       String?
  phone       String?
  name        String?
  categories  String   // JSON array of subscribed categories
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email])
  @@unique([phone])
  @@map("subscriptions")
}

// Push notifications
model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  category    String
  targetUrl   String?
  sent        Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notifications")
}

// Digital discount cards
model DiscountCard {
  id            String   @id @default(cuid())
  userId        String   @unique
  userName      String
  userEmail     String?
  userPhone     String?
  dCode         String   @unique // Discount code
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationship to usage tracking
  usages        DiscountUsage[]

  @@map("discount_cards")
}

// Discount card usage tracking
model DiscountUsage {
  id              String       @id @default(cuid())
  cardId          String
  card            DiscountCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  businessName    String
  businessPhone   String?
  shopkeeperName  String?
  amount          Float?
  usedAt          DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@map("discount_usages")
}

// In-content Ads (displayed between paragraphs in news articles)
model Ad {
  id          String   @id @default(cuid())
  title       String
  title_ta    String?
  imageUrl    String?  // Image ad
  htmlCode    String?  @db.Text // HTML/AdSense code
  link        String?  // Click-through URL
  active      Boolean  @default(true)
  position    Int      @default(0) // Order of display
  category    String?  // Which section (news, videos, etc.)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([position])
  @@map("ads")
}

// Image storage table
model Image {
  id          String   @id @default(cuid())
  filename    String
  data        Bytes    @db.LongBlob // Store the actual image data
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  @@map("images")
}
