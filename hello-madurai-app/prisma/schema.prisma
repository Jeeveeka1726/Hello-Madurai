generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model News {
  id            String        @id @default(cuid())
  title         String        @db.VarChar(500)
  title_ta      String?       @db.VarChar(500)
  content       String        @db.LongText
  content_ta    String?       @db.LongText
  excerpt       String        @db.Text
  excerpt_ta    String?       @db.Text
  category      String
  author        String
  featuredImage String?       @db.VarChar(500)
  publishedAt   DateTime      @default(now())
  views         Int           @default(0)
  likes         Int           @default(0)
  dislikes      Int           @default(0)
  featured      Boolean       @default(false)
  allowDownload Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      NewsComment[]
  shares        NewsShare[]

  @@map("news")
}

model Event {
  id             String    @id @default(cuid())
  title          String
  title_ta       String?
  description    String    @db.Text
  description_ta String?   @db.Text
  location       String
  location_ta    String?
  featuredImage  String?   @db.Text
  startDate      DateTime
  endDate        DateTime?
  category       String
  status         String    @default("upcoming")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  duration       String?
  phone          String?
  views          Int       @default(0)
  website        String?
  endTime        String?
  startTime      String?

  @@map("events")
}

model RadioFolder {
  id             String      @id @default(cuid())
  name           String
  name_ta        String?
  description    String?
  description_ta String?
  coverImage     String?
  featured       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  radioShows     RadioShow[]

  @@map("radio_folders")
}

model RadioShow {
  id             String         @id @default(cuid())
  title          String
  title_ta       String?
  description    String
  description_ta String?
  host           String
  duration       String
  audioUrl       String
  featured       Boolean        @default(false)
  plays          Int            @default(0)
  publishedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  folderId       String
  folder         RadioFolder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  comments       RadioComment[]
  shares         RadioShare[]

  @@map("radio_shows")
}

model DirectoryCategory {
  id            String                 @id @default(cuid())
  name          String
  name_ta       String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  orderNumber   Int                    @default(0)
  subcategories DirectorySubcategory[]
  businesses    Business[]

  @@map("directory_categories")
}

model DirectorySubcategory {
  id          String            @id @default(cuid())
  name        String
  name_ta     String
  categoryId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  icon        String?
  orderNumber Int               @default(0)
  category    DirectoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  businesses  Business[]

  @@index([categoryId])
  @@map("directory_subcategories")
}

model Business {
  id                String                @id @default(cuid())
  name              String
  name_ta           String?
  description       String?
  category          String?
  phone             String?
  email             String?
  website           String?
  address           String
  address_ta        String?
  instagramUrl      String?
  facebookUrl       String?
  bookingUrl        String?
  verified          Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  categoryId        String?
  subcategoryId     String?
  orderNumber       Int                   @default(0)
  hasProfile        Boolean               @default(false)
  youtubeUrl        String?
  profileContent    String?               @db.LongText
  profileContent_ta String?               @db.LongText
  profileImage      String?
  profileVideo      String?
  mainImage         String?
  mainVideoUrl      String?
  directionsUrl     String?
  latitude          Float?
  longitude         Float?
  description_ta    String?
  mainCategory      DirectoryCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory       DirectorySubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  comments          BusinessComment[]
  shares            BusinessShare[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("businesses")
}

model MagazineCollection {
  id             String        @id @default(cuid())
  name           String
  name_ta        String?
  description    String?
  description_ta String?
  coverImage     String?
  featured       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  magazines      Magazine[]
  pdfs           MagazinePdf[]

  @@map("magazine_collections")
}

model Magazine {
  id             String             @id @default(cuid())
  title          String
  title_ta       String?
  description    String
  description_ta String?
  pdfUrl         String
  coverImage     String?
  featuredImage  String?
  issueNumber    String
  publishedAt    DateTime           @default(now())
  downloads      Int                @default(0)
  featured       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  collectionId   String
  likes          Int                @default(0)
  collection     MagazineCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  pdfs           MagazinePdf[]

  @@map("magazines")
}

model NewsComment {
  id           String        @id @default(cuid())
  content      String
  author       String
  email        String?
  approved     Boolean       @default(false)
  isAdminReply Boolean       @default(false)
  newsId       String
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  news         News          @relation(fields: [newsId], references: [id], onDelete: Cascade)
  parent       NewsComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      NewsComment[] @relation("CommentReplies")

  @@index([newsId])
  @@index([approved])
  @@index([parentId])
  @@map("news_comments")
}

model NewsShare {
  id        String   @id @default(cuid())
  newsId    String
  platform  String
  userAgent String?
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("news_shares")
}

model RadioComment {
  id          String    @id @default(cuid())
  content     String
  author      String
  email       String?
  radioShowId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  radioShow   RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade)

  @@map("radio_comments")
}

model RadioShare {
  id          String    @id @default(cuid())
  radioShowId String
  platform    String
  userAgent   String?
  createdAt   DateTime  @default(now())
  radioShow   RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade)

  @@map("radio_shares")
}

model BusinessComment {
  id         String   @id @default(cuid())
  content    String
  author     String
  email      String?
  rating     Int?
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_comments")
}

model BusinessShare {
  id         String   @id @default(cuid())
  businessId String
  platform   String
  userAgent  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_shares")
}

model Helpline {
  id             String   @id @default(cuid())
  name           String
  name_ta        String?
  phone          String
  category       String
  description    String?
  description_ta String?
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("helplines")
}

model PopupAd {
  id          String    @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  actionUrl   String?
  actionText  String?
  active      Boolean   @default(true)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("popup_ads")
}

model Subscription {
  id         String   @id @default(cuid())
  email      String?  @unique
  phone      String?  @unique
  name       String?
  categories String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("subscriptions")
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  category  String
  targetUrl String?
  sent      Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("notifications")
}

model DiscountCard {
  id        String          @id @default(cuid())
  userId    String          @unique
  userName  String
  userEmail String?
  userPhone String?
  dCode     String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  usages    DiscountUsage[]

  @@map("discount_cards")
}

model DiscountUsage {
  id             String       @id @default(cuid())
  cardId         String
  businessName   String
  businessPhone  String?
  shopkeeperName String?
  amount         Float?
  usedAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  card           DiscountCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("discount_usages")
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  title_ta    String?
  imageUrl    String?
  htmlCode    String?  @db.Text
  link        String?
  active      Boolean  @default(true)
  position    Int      @default(0)
  category    String?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([position])
  @@map("ads")
}

model Image {
  id        String   @id @default(cuid())
  filename  String
  data      Bytes
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@map("images")
}

model Offer {
  id          String   @id @default(cuid())
  title       String
  title_ta    String?
  imageUrl    String
  bookNowUrl  String
  active      Boolean  @default(true)
  orderNumber Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([orderNumber])
  @@map("offers")
}

model Audio {
  id        String   @id @default(cuid())
  filename  String
  data      Bytes?
  mimeType  String
  size      Int
  duration  String?
  createdAt DateTime @default(now())
  publicId  String?
  url       String?

  @@map("audio_files")
}

model MagazinePdf {
  id           String              @id @default(cuid())
  filename     String
  url          String?             @db.LongText
  publicId     String?
  mimeType     String
  size         Int
  magazineId   String?
  collectionId String?
  createdAt    DateTime            @default(now())
  magazine     Magazine?           @relation(fields: [magazineId], references: [id], onDelete: SetNull)
  collection   MagazineCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@map("magazine_pdfs")
}

model Video {
  id           String         @id @default(cuid())
  title        String
  title_ta     String?
  videoUrl     String
  thumbnailUrl String?
  category     String
  duration     String?
  views        Int            @default(0)
  likes        Int            @default(0)
  dislikes     Int            @default(0)
  featured     Boolean        @default(false)
  publishedAt  DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orderNumber  Int            @default(0)
  videoType    String         @default("upload")
  comments     VideoComment[]
  shares       VideoShare[]

  @@map("videos")
}

model VideoComment {
  id        String   @id @default(cuid())
  content   String
  author    String
  email     String?
  videoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_comments")
}

model VideoShare {
  id        String   @id @default(cuid())
  videoId   String
  platform  String
  userAgent String?
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_shares")
}

model Reel {
  id           String   @id @default(cuid())
  title        String
  title_ta     String?
  videoUrl     String
  thumbnailUrl String?
  reelType     String   @default("youtube") // "youtube", "instagram", "upload"
  duration     String?
  views        Int      @default(0)
  likes        Int      @default(0)
  active       Boolean  @default(true)
  orderNumber  Int      @default(0)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([orderNumber])
  @@map("reels")
}

model RadioCategory {
  id          String   @id @default(cuid())
  name        String
  name_ta     String
  slug        String   @unique
  orderNumber Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  singers     Singer[]

  @@map("radio_categories")
}

model Singer {
  id          String          @id @default(cuid())
  name        String
  name_ta     String?
  imageUrl    String?
  categoryId  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  featured    Boolean         @default(false)
  slug        String?         @unique
  orderNumber Int             @default(0)
  category    RadioCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  songs       RadioSong[]
  comments    SingerComment[]

  @@index([categoryId])
  @@index([featured])
  @@index([slug])
  @@index([orderNumber])
  @@map("singers")
}

model RadioSong {
  id        String     @id @default(cuid())
  title     String
  title_ta  String?
  audioUrl  String
  duration  String?
  plays     Int        @default(0)
  singerId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shares    Int        @default(0)
  audioType String     @default("direct")
  singer    Singer     @relation(fields: [singerId], references: [id], onDelete: Cascade)
  likes     SongLike[]

  @@index([singerId])
  @@map("radio_songs")
}

model AnonymousUser {
  id           String          @id @default(cuid())
  sessionToken String          @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastSeenAt   DateTime        @default(now())
  likes        SongLike[]
  comments     SingerComment[]

  @@index([sessionToken])
  @@map("anonymous_users")
}

model SongLike {
  id        String        @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime      @default(now())
  user      AnonymousUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      RadioSong     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
  @@map("song_likes")
}

model SingerComment {
  id           String          @id @default(cuid())
  content      String          @db.Text
  author       String
  userId       String?
  singerId     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isAdminReply Boolean         @default(false)
  parentId     String?
  user         AnonymousUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  singer       Singer          @relation(fields: [singerId], references: [id], onDelete: Cascade)
  parent       SingerComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      SingerComment[] @relation("CommentReplies")

  @@index([userId])
  @@index([singerId])
  @@index([parentId])
  @@map("singer_comments")
}

model pdf_chunks {
  id          String   @id
  uploadId    String
  chunkIndex  Int
  chunkData   String   @db.LongText
  filename    String
  mimeType    String
  totalChunks Int
  createdAt   DateTime @default(now())

  @@index([uploadId])
}
