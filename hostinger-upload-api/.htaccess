# Hostinger PDF Upload API Configuration
# Place this in /public_html/api/ directory

# Multiple server-level upload limits
LimitRequestBody 536870912
# 512MB in bytes (512 * 1024 * 1024)

# Nginx-style limits (if Hostinger uses Nginx)
client_max_body_size 512M;

# Apache mod_fcgid limits
FcgidMaxRequestLen 536870912

# Increase PHP limits for large file uploads
php_value upload_max_filesize 512M
php_value post_max_size 512M
php_value memory_limit 512M
php_value max_execution_time 300
php_value max_input_time 300

# Enable CORS for all domains
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "POST, OPTIONS, GET"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
Header always set Access-Control-Max-Age "3600"

# Allow all file access (less restrictive)
<Files "*">
    Order Allow,Deny
    Allow from all
</Files>

# Enable error logging
php_flag log_errors on
php_value error_log error.log

# Additional server limits for large uploads
RewriteEngine On