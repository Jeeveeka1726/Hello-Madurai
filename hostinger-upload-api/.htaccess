# Hostinger Upload Configuration
# Place this in the SAME directory as upload-pdf-simple.php (e.g. /public_html/)

# ── PHP limits (Apache / LiteSpeed shared hosting) ───────────────────────────
php_value upload_max_filesize 100M
php_value post_max_size 100M
php_value memory_limit 256M
php_value max_execution_time 300
php_value max_input_time 300

# Apache request body limit (100MB)
LimitRequestBody 104857600

# ── CORS headers ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST, OPTIONS, GET"
    Header always set Access-Control-Allow-Headers "Content-Type, Accept"
    Header always set Access-Control-Max-Age "3600"
</IfModule>

# ── Allow access to all files in this directory ───────────────────────────────
<Files "*">
    Order Allow,Deny
    Allow from all
</Files>

# ── Error logging ─────────────────────────────────────────────────────────────
php_flag log_errors on